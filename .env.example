# Copia este archivo a .env (nunca commitear .env) y completa los valores.
# Lo usa docker-compose.yml para los servicios postgres_db e inventory_backend.
# En Railway estas mismas variables se definen en el servicio (ver README).

# --- PostgreSQL ---
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Spring Boot backend ---
# Deben coincidir con POSTGRES_USER/POSTGRES_PASSWORD de arriba.
DB_USER=postgres
DB_PASSWORD=change-me

# Secreto para firmar los JWT y los códigos de un solo uso (mínimo 32 bytes). Generar uno con:
#   openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRATION=3600

# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# URL pública del frontend (los enlaces de recuperación de contraseña apuntan ahí).
FRONTEND_URL=http://localhost:5173

# Cookie de sesión: en http://localhost poner COOKIE_SECURE=false; en producción dejar true.
# COOKIE_SECURE=false

# --- Correo ---
# Opción recomendada en producción (Railway bloquea SMTP): API HTTP de Brevo, gratis
# (300 correos/día). Brevo > SMTP & API > pestaña "API keys & MCP" > Generate a new API key.
# Si BREVO_API_KEY tiene valor, las variables SMTP de abajo se ignoran.
BREVO_API_KEY=
# Remitente: debe estar verificado en Brevo (Senders & IP > Senders).
MAIL_FROM=
MAIL_FROM_NAME=Multiservicios Wilson

# Alternativa por SMTP (desarrollo): Mailtrap Sandbox, Email Testing > Inboxes > SMTP Settings.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
