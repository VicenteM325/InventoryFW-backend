# Copie este archivo a .env y complete los valores. .env esta en .gitignore.
DB_USER=postgres
DB_PASSWORD=
# Minimo 32 caracteres (HS256).
JWT_SECRET=
JWT_EXPIRATION=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Mailtrap Sandbox (Email Testing > Inboxes > SMTP Settings)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@inventoryfw.local
FRONTEND_URL=http://localhost:5173
